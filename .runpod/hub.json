{
  "title": "K1: Qwen3-8B Inference",
  "description": "OpenAI-compatible Qwen3-8B chat, streaming and tool calling. Pinned BF16 configuration with thinking disabled, based on the Runpod LLM inference starter kit.",
  "type": "serverless",
  "category": "language",
  "config": {
    "runsOn": "GPU",
    "containerDiskInGb": 60,
    "gpuCount": 1,
    "gpuIds": "ADA_24,AMPERE_24,AMPERE_48,-NVIDIA GeForce RTX 3090,-NVIDIA L4,-NVIDIA RTX A6000,-NVIDIA RTX PRO 6000 Blackwell Server Edition MIG 1g.24gb",
    "allowedCudaVersions": [
      "13.0",
      "13.1",
      "13.2",
      "13.3",
      "13.4"
    ],
    "env": [
      {
        "key": "MODEL_NAME",
        "value": "Qwen/Qwen3-8B"
      },
      {
        "key": "MODEL_REVISION",
        "value": "b968826d9c46dd6066d109eabc6255188de91218"
      },
      {
        "key": "OPENAI_SERVED_MODEL_NAME_OVERRIDE",
        "value": "qwen3-8b"
      },
      {
        "key": "TRUST_REMOTE_CODE",
        "value": "false"
      },
      {
        "key": "MAX_MODEL_LEN",
        "value": "8192"
      },
      {
        "key": "GPU_MEMORY_UTILIZATION",
        "value": "0.9"
      },
      {
        "key": "DTYPE",
        "value": "bfloat16"
      },
      {
        "key": "ENABLE_AUTO_TOOL_CHOICE",
        "value": "true"
      },
      {
        "key": "TOOL_CALL_PARSER",
        "value": "hermes"
      },
      {
        "key": "MAX_NUM_SEQS",
        "value": "8"
      },
      {
        "key": "MAX_CONCURRENCY",
        "value": "8"
      },
      {
        "key": "VLLM_EXTRA_ARGS",
        "value": "--default-chat-template-kwargs '{\"enable_thinking\":false}'"
      }
    ]
  }
}
